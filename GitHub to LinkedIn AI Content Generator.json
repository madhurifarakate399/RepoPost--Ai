    {
      "parameters": {
        "jsCode": "const files = $input.all();\n\nconst images = files.filter(item => {\n  const file = item.json;\n  const name = (file.name || \"\").toLowerCase();\n\n  return file.type === \"file\" &&\n    /\\.(png|jpe?g|webp|gif)$/i.test(name) &&\n    !!file.download_url;\n});\n\nif (images.length === 0) {\n  throw new Error(\n    \"No image found in this repository path. Check the repository files or search subfolders.\"\n  );\n}\n\nreturn [images[0]];"
      },

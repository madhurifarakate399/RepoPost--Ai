      "name": "Get GitHub Repository",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        288,
        -16
      ],
      "notesInFlow": true,
      "credentials": {
        "githubApi": {
          "id": "Q8kLGnSQ77x5zfT0",

      "notes": "Demo repository: n8n-io/n8n. Change the URL to https://api.github.com/repos/OWNER/REPOSITORY to use your own public repository. No GitHub token is needed for basic public repository details."
    },
    {
      "parameters": {
        "jsCode": "\nconst repo = $input.first().json;\n\nconst topics = Array.isArray(repo.topics)\n  ? repo.topics.join(\", \")\n  : (repo.topics || \"\");\n\nconst prompt = `\nWrite one authentic, professional LinkedIn post about this GitHub repository.\n\nInclude the repository name, what it does, its description,\nmain programming language, GitHub stars, forks, topics,\nand repository URL wherever those details are available.\n\nExplain why the project may be useful. Use a strong opening,\nshort readable paragraphs, an invitation to explore the repository,\nand 3-5 relevant hashtags.\n\nUse only the supplied facts. Do not invent features or claim\nthat I built or contributed to this project.\nReturn only the LinkedIn post text.\n\nRepository: ${repo.full_name || repo.repo_name || \"\"}\nURL: ${repo.html_url || repo.repo_url || \"\"}\nDescription: ${repo.description || \"Not provided\"}\nMain language: ${repo.language || \"Not provided\"}\nStars: ${repo.stargazers_count ?? repo.stars ?? \"Not provided\"}\nForks: ${repo.forks_count ?? repo.forks ?? \"Not provided\"}\nTopics: ${topics || \"Not provided\"}\n`;\n\nreturn [{\n  json: {\n    repo_name: repo.full_name || repo.repo_name || \"\",\n    repo_url: repo.html_url || repo.repo_url || \"\",\n    description: repo.description || \"\",\n    language: repo.language || \"\",\n    stars: repo.stargazers_count ?? repo.stars ?? 0,\n    forks: repo.forks_count ?? repo.forks ?? 0,\n    topics,\n    prompt\n  }\n}];\n"
      },
